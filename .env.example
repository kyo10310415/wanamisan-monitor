# Server Configuration
PORT=3000
NODE_ENV=development

# SSO Authentication (WannaV Dashboard)
JWT_SECRET=
DASHBOARD_URL=https://wannav-main.onrender.com

# Required outside Render; Render may use RENDER_EXTERNAL_URL instead.
APP_ORIGIN=https://monitor.example.com
# Read-only access to the private usage-log sheet; never use a public CSV fallback.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_RANGE=
